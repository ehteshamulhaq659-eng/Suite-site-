# Select "demo" for local preview without a database.
# Switch to "neon" only after connecting your Neon PostgreSQL database and applying migrations.
DATA_MODE=demo

# Neon connection string. Copy it from Neon Console > Connection Details.
# Keep this server-only. Never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Better Auth. Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public business contact. Enter digits only, including country code, e.g. 92xxxxxxxxxx.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_PHONE=

# Optional Cloudinary credentials. Required for managed cloud image uploads in Neon mode.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store operations. Prices and currency are configured as PKR by default.
STORE_CURRENCY=PKR
DEFAULT_DELIVERY_FEE=250
FREE_DELIVERY_THRESHOLD=
